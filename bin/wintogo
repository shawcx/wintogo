#!/usr/bin/env python3
# Entry point that works from a source checkout, including under pkexec
# (which resets PYTHONPATH and the working directory).
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from wintogo.cli import main  # noqa: E402

sys.exit(main())
