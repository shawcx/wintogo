<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- pkexec matches a policy by program and first argument: the GUI runs the
     packaged backend as "pkexec /usr/bin/python3 /usr/share/wintogo/bin/wintogo". -->
<policyconfig>
  <action id="io.github.wintogo.write-drive">
    <description>Install Windows onto a USB drive</description>
    <message>Authentication is required to erase the drive and install Windows on it</message>
    <icon_name>io.github.wintogo</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/python3</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">/usr/share/wintogo/bin/wintogo</annotate>
  </action>
</policyconfig>
